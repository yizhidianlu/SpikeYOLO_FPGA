# Git LFS — track large FPGA build artefacts so they sync between
# the main developer machine and the Vivado synthesis runner.
#
# Setup is documented in docs/GIT_LFS_SETUP.md.
#
# Notes:
#   - tests/golden/*.bin is already excluded by .gitignore (small per-layer
#     golden binaries are regenerated by tools/verify/extract_golden.py),
#     so the *.bin filter below only catches hw/ + sw/ runtime blobs
#     (e.g. models/tiny_fpga_int8.bin, sw/petalinux/images/linux/*).
#   - *.npy is also gitignored under runs/ + tests/golden/; the filter
#     here is a forward-compatibility net for any future tracked .npy.
#   - Existing committed blobs (e.g. models/tiny_fpga_int8.bin) stay in
#     classic git history. Only NEW commits route through LFS. Use
#     `git lfs migrate import` to retro-fit if quota becomes an issue.

# HLS / Vivado synthesis outputs
*.xo   filter=lfs diff=lfs merge=lfs -text
*.bit  filter=lfs diff=lfs merge=lfs -text
*.hwh  filter=lfs diff=lfs merge=lfs -text
*.dcp  filter=lfs diff=lfs merge=lfs -text
*.xsa  filter=lfs diff=lfs merge=lfs -text
*.ltx  filter=lfs diff=lfs merge=lfs -text

# Petalinux + firmware blobs
*.bin  filter=lfs diff=lfs merge=lfs -text
*.ub   filter=lfs diff=lfs merge=lfs -text
*.wic  filter=lfs diff=lfs merge=lfs -text
BOOT.BIN filter=lfs diff=lfs merge=lfs -text

# Bulk numpy tensors (forward-compat — most are gitignored today)
*.npy  filter=lfs diff=lfs merge=lfs -text
*.npz  filter=lfs diff=lfs merge=lfs -text

# Line-ending normalisation (avoid CRLF noise on cross-OS commits)
*.tcl text eol=lf
*.sh  text eol=lf
*.py  text eol=lf
*.cpp text eol=lf
*.h   text eol=lf
*.md  text eol=lf
