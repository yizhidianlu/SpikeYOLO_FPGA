# Git LFS — track large FPGA build artefacts so they sync between
# the main developer machine and the Vivado synthesis runner.
#
# Setup is documented in docs/GIT_LFS_SETUP.md.
#
# IMPORTANT: only types that are NOT yet committed go through LFS here.
# *.npy / *.npz / *.bin / *.npz are already in classic git history (W3-W7
# commits for models/exploded/, tiny_fpga_int8.{bin,npz}, tests/golden/
# exploded/). Adding LFS filter for those types would make every clone
# show 200+ "modified" files (raw blob in history vs LFS pointer expected
# in working tree). If quota ever becomes an issue, do a one-time
# `git lfs migrate import --include="*.npy,*.npz,*.bin" --everything` and
# force-push — but that rewrites history.

# === LFS-tracked: new artefact types only (Vivado / HLS synth outputs) ===
*.xo   filter=lfs diff=lfs merge=lfs -text
*.bit  filter=lfs diff=lfs merge=lfs -text
*.hwh  filter=lfs diff=lfs merge=lfs -text
*.dcp  filter=lfs diff=lfs merge=lfs -text
*.xsa  filter=lfs diff=lfs merge=lfs -text
*.ltx  filter=lfs diff=lfs merge=lfs -text

# Petalinux deployable image artefacts (NOT firmware .bin — see note above)
*.ub   filter=lfs diff=lfs merge=lfs -text
*.wic  filter=lfs diff=lfs merge=lfs -text
BOOT.BIN filter=lfs diff=lfs merge=lfs -text

# Intentionally NOT in LFS (already in classic git history):
#   *.npy   -> models/exploded/L*.npy, tests/golden/exploded/*/*.npy
#   *.npz   -> models/tiny_fpga_int8.npz, tests/golden_layerwise/*.npz, synthetic_backup
#   *.bin   -> models/tiny_fpga_int8.bin, tiny_fpga_int8_v6.bin

# Line-ending normalisation (avoid CRLF noise on cross-OS commits)
*.tcl text eol=lf
*.sh  text eol=lf
*.py  text eol=lf
*.cpp text eol=lf
*.h   text eol=lf
*.md  text eol=lf
