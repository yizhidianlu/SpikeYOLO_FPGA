# sw/petalinux/project-spec/configs/config
# (subset — the rest is auto-generated by petalinux-config)

CONFIG_SUBSYSTEM_MACHINE_NAME="zybo-z7-20"

# ---- Boot ---------------------------------------------------------------
CONFIG_SUBSYSTEM_PRIMARY_SD_PSU_SD_1_SELECT=y
CONFIG_SUBSYSTEM_BOOTARGS_AUTO=y
CONFIG_SUBSYSTEM_USER_CMDLINE="console=ttyPS0,115200 earlycon root=/dev/mmcblk0p2 rw rootwait cma=256M"

# ---- Rootfs -------------------------------------------------------------
CONFIG_SUBSYSTEM_ROOTFS_INITRAMFS=n
CONFIG_SUBSYSTEM_ROOTFS_SD=y
CONFIG_SUBSYSTEM_ROOTFS_EXT4=y
CONFIG_SUBSYSTEM_INITRAMFS_IMAGE_NAME="petalinux-image-minimal"

# ---- FPGA Manager (re-load .bit at boot) -------------------------------
CONFIG_SUBSYSTEM_FPGA_MANAGER=y

# ---- u-boot quality of life --------------------------------------------
CONFIG_SUBSYSTEM_UBOOT_AUTOCONFIG=y
